Config = {}

Config.Locale = 'en' -- Language of the /twlib menu: en, tr, de, fr, es, pt, ru, nl, sv, hu, ro, ja, ar

Config.Admin = {
    ace = 'tw-lib.admin', -- Players with this ACE open /twlib. In server.cfg: add_ace group.admin tw-lib.admin allow
    frameworkAdmins = true, -- QBCore / QBox admins (god, admin) and ESX admins (admin, superadmin) open /twlib too
    identifiers = '', -- Anyone else, comma separated: 'license:1a2b3c..., discord:1234..., fivem:5678, steam:1100001..., ABC12345' (a citizenid works too)
}
